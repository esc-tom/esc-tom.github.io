rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own data (for read/update/delete)
    // Supports both new custom ID system (checks authUid field) and old system (userId == auth.uid)
    function isOwner(userId) {
      return isAuthenticated() && (
        // New system: document's authUid field matches authenticated user
        (resource.data.authUid != null && resource.data.authUid == request.auth.uid) ||
        // Backward compatibility: userId matches auth.uid (old system)
        (userId == request.auth.uid)
      );
    }
    
    // Helper function to check if user can create/update their own document
    // For create/update operations, check the request.resource.data
    function canWriteOwnDocument(userId) {
      return isAuthenticated() && (
        // New system: request contains authUid that matches authenticated user
        (request.resource.data.authUid != null && request.resource.data.authUid == request.auth.uid) ||
        // Backward compatibility: userId matches auth.uid (old system)
        (userId == request.auth.uid)
      );
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Allow authenticated users to read user profiles
      // This is needed for:
      // - Users reading their own profile
      // - Prolific participant lookups (query by participantId)
      // - Username availability checks (query by username)
      // Note: While this allows reading any user profile, write is restricted to own profile
      allow read: if isAuthenticated();
      
      // Allow users to create their own profile (during registration)
      // Also allows ensureUserDocumentExists to create missing profiles
      // Note: set() with merge uses update permission, but we allow create for safety
      // Supports custom ID system: checks if authUid in request matches authenticated user
      allow create: if canWriteOwnDocument(userId)
                    && request.resource.data.username is string
                    && request.resource.data.email is string;
      
      // Allow users to update their own profile
      // Allows updates for: feedback, prolific data, lastActiveAt, assignedDialogues, etc.
      // Supports both new custom ID system and backward compatibility
      allow update: if canWriteOwnDocument(userId) || isOwner(userId);
      
      // Allow users to write their own profile (for set operations with merge)
      // Needed for: registration, profile recreation, ensureUserDocumentExists
      // Supports both new custom ID system and backward compatibility
      allow write: if canWriteOwnDocument(userId) || isOwner(userId);
      
      // Allow queries on users collection
      // Needed for: getAllUsers(), getProlificUserByParticipantId(), getUsernameStatus()
      // Results are still filtered by read permissions
      allow list: if isAuthenticated();
      
      // ============================================
      // ANNOTATIONS SUBCOLLECTION
      // ============================================
      match /annotations/{annotationId} {
        // Helper to check if user owns the parent user document
        // Supports both new custom ID system and old Auth UID system
        function ownsParentUser() {
          return isAuthenticated() && (
            // Check 1: userId in path matches auth.uid (old system - backward compatibility)
            // This covers users created before custom ID system
            userId == request.auth.uid ||
            // Check 2: parent document's authUid field matches authenticated user (new custom ID system)
            // IMPORTANT: Check exists() first to prevent permission errors
            (exists(/databases/$(database)/documents/users/$(userId)) && 
             get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid)
          );
        }
        
        // Allow users to read their own annotations
        // userId here is the custom ID (participantId or username) or Auth UID from parent path
        allow read: if ownsParentUser();
        
        // Allow users to create/update their own annotations
        // userId in annotation data should match the custom ID from parent path OR Auth UID (for backward compatibility)
        allow create: if ownsParentUser()
                      && request.resource.data.keys().hasAll(['userId', 'username', 'dialogueId'])
                      && (request.resource.data.userId == userId || request.resource.data.userId == request.auth.uid)
                      && request.resource.data.username is string
                      && request.resource.data.dialogueId is string;
        
        allow update: if ownsParentUser()
                      && (request.resource.data.userId == userId || request.resource.data.userId == request.auth.uid);
        
        // Allow write (for set with merge operations)
        allow write: if ownsParentUser()
                     && (request.resource.data.userId == userId || request.resource.data.userId == request.auth.uid);
        
        // Allow delete (for cleanup operations)
        allow delete: if ownsParentUser();
      }
      
      // ============================================
      // AGREEMENT ANNOTATIONS SUBCOLLECTION
      // ============================================
      match /agreement_annotations/{annotationId} {
        // Helper to check if user owns the parent user document
        // Supports both new custom ID system and old Auth UID system
        function ownsParentUser() {
          return isAuthenticated() && (
            // Check 1: userId in path matches auth.uid (old system - backward compatibility)
            // This covers users created before custom ID system
            userId == request.auth.uid ||
            // Check 2: parent document's authUid field matches authenticated user (new custom ID system)
            // IMPORTANT: Check exists() first to prevent permission errors
            (exists(/databases/$(database)/documents/users/$(userId)) && 
             get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid)
          );
        }
        
        // Allow users to read their own agreement annotations
        // userId here is the custom ID (participantId or username) or Auth UID from parent path
        allow read: if ownsParentUser();
        
        // Allow users to create/update their own agreement annotations
        // userId in annotation data should match the custom ID from parent path OR Auth UID (for backward compatibility)
        allow create: if ownsParentUser()
                      && request.resource.data.keys().hasAll(['userId', 'username', 'dialogueId'])
                      && (request.resource.data.userId == userId || request.resource.data.userId == request.auth.uid)
                      && request.resource.data.username is string
                      && request.resource.data.dialogueId is string;
        
        allow update: if ownsParentUser()
                      && (request.resource.data.userId == userId || request.resource.data.userId == request.auth.uid);
        
        // Allow write (for set with merge operations)
        allow write: if ownsParentUser()
                     && (request.resource.data.userId == userId || request.resource.data.userId == request.auth.uid);
        
        // Allow delete (for cleanup operations)
        allow delete: if ownsParentUser();
      }
    }
    
    // ============================================
    // LEGACY ANNOTATIONS COLLECTION (for backward compatibility)
    // ============================================
    match /annotations/{annotationId} {
      // Allow authenticated users to read legacy annotations
      allow read: if isAuthenticated();
      
      // Allow users to write/delete their own legacy annotations
      // Legacy format: {userId}_{dialogueId}
      allow write: if isAuthenticated()
                   && (annotationId.matches('.*_.*') 
                       ? annotationId.split('_')[0] == request.auth.uid
                       : false);
      
      allow delete: if isAuthenticated()
                    && (annotationId.matches('.*_.*') 
                        ? annotationId.split('_')[0] == request.auth.uid
                        : false);
    }
  }
}